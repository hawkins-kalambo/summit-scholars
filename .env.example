# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public origin; use http://localhost:3000 for local development.
APP_URL=http://localhost:3000
# Server-only transactional email configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Required for private library file delivery/uploads and notification dispatch; server-only.
# Accepts a Supabase secret key (sb_secret_...) or legacy service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters; scheduler sends it as a Bearer token.
CRON_SECRET=
# Optional: auto-create Google Meet links for scheduled classes from one institution
# Google account (OAuth client + a refresh token obtained once for that account).
# Leave unset and tutors paste a meeting link manually, as today.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
